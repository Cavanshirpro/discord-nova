# Pinned upstream C ABI shared library; works with MSVC, MinGW and Apple/GNU Clang.
include(CMakePackageConfigHelpers)
set(NOVA_BROWSER_VERSION 2.3.2)
if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "ARM|arm|aarch")
    set(_nova_browser_platform x86_64-win32)
    set(_nova_browser_hash 4c416b5e50716199c4f6541b660fdada9a049cd0bdb72e92bdee4d4da27d39db)
elseif(APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
    set(_nova_browser_platform arm64-macos)
    set(_nova_browser_hash 6c0dc841a8f6b7a8f81a0f55197e8241405fb7dcd97df180e66fc6f796c42bd5)
elseif(APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
    set(_nova_browser_platform x86_64-macos)
    set(_nova_browser_hash eed3342d8768065ab7a9106f4286d9101959b7e9e1b2b969eb8d8be1a52422cd)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
    set(_nova_browser_platform aarch64-linux-gnu)
    set(_nova_browser_hash 1cb74a3b5103df020c252f9efef5a779c87380ee6244b365a90a0e4f7086864e)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
    set(_nova_browser_platform x86_64-linux-gnu)
    set(_nova_browser_hash 7716be1ec87f13ecc776c211003bd1122c345287829b1f18a494a5467c90ab1e)
else()
    message(FATAL_ERROR "No pinned browser runtime for this platform. Set NOVA_BROWSER_IDENTITY=OFF to use system curl.")
endif()
FetchContent_Declare(nova_browser
    URL "https://github.com/lexiforest/curl-impersonate/releases/download/v${NOVA_BROWSER_VERSION}/libcurl-impersonate-v${NOVA_BROWSER_VERSION}.${_nova_browser_platform}.tar.gz"
    URL_HASH "SHA256=${_nova_browser_hash}"
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(nova_browser)
set(NOVA_BROWSER_RUNTIME_DIR "${nova_browser_SOURCE_DIR}" CACHE INTERNAL "Verified browser TLS runtime" FORCE)
file(GLOB _nova_browser_libraries "${NOVA_BROWSER_RUNTIME_DIR}/libcurl-impersonate.so*" "${NOVA_BROWSER_RUNTIME_DIR}/libcurl-impersonate*.dylib")
if(WIN32)
    set(NOVA_BROWSER_LIBRARY "${NOVA_BROWSER_RUNTIME_DIR}/lib/libcurl-impersonate.dll")
    set(NOVA_BROWSER_IMPLIB "${NOVA_BROWSER_RUNTIME_DIR}/lib/libcurl-impersonate_imp.lib")
    set(_nova_browser_libraries "${NOVA_BROWSER_LIBRARY}")
else()
    if(APPLE)
        set(NOVA_BROWSER_LIBRARY "${NOVA_BROWSER_RUNTIME_DIR}/libcurl-impersonate.dylib")
    else()
        set(NOVA_BROWSER_LIBRARY "${NOVA_BROWSER_RUNTIME_DIR}/libcurl-impersonate.so")
    endif()
endif()
if(NOT EXISTS "${NOVA_BROWSER_LIBRARY}")
    message(FATAL_ERROR "Pinned browser SDK is missing its shared library: ${NOVA_BROWSER_LIBRARY}")
endif()
set(NOVA_BROWSER_CA_BUNDLE "${CMAKE_CURRENT_BINARY_DIR}/browser-cacert.pem" CACHE INTERNAL "Pinned Mozilla trust roots" FORCE)
file(DOWNLOAD "https://curl.se/ca/cacert-2026-10-20.pem" "${NOVA_BROWSER_CA_BUNDLE}"
    EXPECTED_HASH SHA256=796f1389bfea13c0ed78f663b765baaff54a508e5483786bd6ece73c5e3e3cbe TLS_VERIFY ON)
configure_file("${CMAKE_CURRENT_LIST_DIR}/BrowserCurlConfig.cmake.in" "${CMAKE_CURRENT_BINARY_DIR}/browser-curl/CURLConfig.cmake" @ONLY)
write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/browser-curl/CURLConfigVersion.cmake" VERSION 8.23.0 COMPATIBILITY AnyNewerVersion)
set(CURL_DIR "${CMAKE_CURRENT_BINARY_DIR}/browser-curl")
set(DISCORD_SELF_CURL_IMPERSONATE ON CACHE BOOL "" FORCE)

function(nova_browser_runtime target)
    if(WIN32)
        foreach(_runtime IN LISTS _nova_browser_libraries)
            add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_runtime}" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
        endforeach()
    endif()
    add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${NOVA_BROWSER_CA_BUNDLE}" "$<TARGET_FILE_DIR:${target}>/cacert.pem" VERBATIM)
endfunction()
install(FILES "${NOVA_BROWSER_CA_BUNDLE}" DESTINATION bin RENAME cacert.pem COMPONENT Runtime)
if(WIN32)
    install(FILES "${NOVA_BROWSER_LIBRARY}" DESTINATION bin COMPONENT Runtime)
elseif(NOT APPLE)
    install(FILES ${_nova_browser_libraries} DESTINATION lib COMPONENT Runtime)
endif()
file(GLOB _nova_browser_licenses "${NOVA_BROWSER_RUNTIME_DIR}/LICENSE*")
install(FILES ${_nova_browser_licenses} DESTINATION share/licenses/curl-impersonate COMPONENT Runtime)
install(FILES "${CMAKE_CURRENT_LIST_DIR}/licenses/MPL-2.0.txt" DESTINATION share/licenses/mozilla-ca COMPONENT Runtime)
